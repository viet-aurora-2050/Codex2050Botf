# --- Casino-Bonus- & Umsatz-Analytiker ---
# Alle Werte sind OPTIONAL. Der Rechner (CLI + Web) laeuft auch ohne Secrets.

# Telegram-Bot-Token (nur fuer den Bot-Betrieb). Niemals committen!
TELEGRAM_TOKEN=

# DeepSeek API-Key (nur fuer die KI-gestuetzte AGB-Analyse via /analyse)
DEEPSEEK_API_KEY=

# Zugriff auf bestimmte Telegram-User beschraenken (Komma-getrennt, nur Zahlen).
# DRINGEND setzen, sobald die KI aktiv ist: leer = oeffentlicher Bot, Fremde koennen KI-Kosten verursachen.
ALLOWED_USER_IDS=

# Anfragen pro Nutzer und Minute (0 = aus)
RATE_LIMIT_PER_MINUTE=10

# Nur fuer den Webhook-Betrieb: langes zufaelliges Geheimnis; beim setWebhook-Aufruf als secret_token mitgeben.
# Ohne Wert lehnt /telegram/webhook alle Anfragen ab (403).
TELEGRAM_WEBHOOK_SECRET=

# Web-Dashboard-Port (von Render automatisch als PORT gesetzt)
WEB_PORT=8080
